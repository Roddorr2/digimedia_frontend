DirectoryIndex index.html

# Cache headers for static assets
<IfModule mod_headers.c>
  # -------------------------------------------------------------
  # Security Headers (VUL02 Fix)
  # -------------------------------------------------------------
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss: ws:; frame-src 'self' https://challenges.cloudflare.com https://www.googletagmanager.com https://www.google.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://*.digimedia-marketing.com; upgrade-insecure-requests;"

  # Images - 1 year cache
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Fonts - 1 year cache
  <FilesMatch "\.(woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # CSS/JS - 1 year cache
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Desactivar ModSecurity (si lo necesitas)
SecFilterEngine Off
SecFilterScanPOST Off

RewriteEngine On
RewriteBase /

# 0. Forzar dominio sin www (evita contenido duplicado en Google Search Console)
RewriteCond %{HTTP_HOST} ^www\.digimedia-marketing\.com$ [NC]
RewriteRule ^(.*)$ https://digimedia-marketing.com/$1 [R=301,L]

# 1. Ignorar solicitudes RSC/Next.js prefetch que fallen en export estático
RewriteCond %{QUERY_STRING} _rsc= [NC]
RewriteRule ^ - [L]

# 1b. Redirigir URLs viejas del blog (?blog=slug) a las nuevas rutas limpias,
# pero solo si esa página estática ya fue generada (evita 301 hacia un 404
# en posts recién publicados que aún no pasaron por un nuevo build)
RewriteCond %{QUERY_STRING} ^blog=([a-zA-Z0-9-]+)$
RewriteCond %{DOCUMENT_ROOT}/blog/plantilla$1/%1/index.html -f
RewriteRule ^blog/plantilla([1-3])/?$ /blog/plantilla$1/%1/? [R=301,L]

# 2. Archivos y directorios existentes — no tocar
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Excluir _next/ completamente del trailing slash
RewriteCond %{REQUEST_URI} ^/_next/
RewriteRule ^ - [L]

# 4. Excluir extensiones estáticas del trailing slash
RewriteCond %{REQUEST_URI} \.(txt|json|js|css|html|png|jpg|jpeg|svg|webp|ico|woff|woff2|avif)$ [NC]
RewriteRule ^ - [L]

# 5. Trailing slash solo a rutas limpias
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# 5b. Blog recién publicado que aún no tiene build propio: servir la
# plantilla de respaldo "nuevo" (trae el contenido en vivo por API)
# SIN redirigir, para que la URL limpia funcione de inmediato aunque
# no se haya vuelto a compilar el sitio.
RewriteCond %{REQUEST_URI} ^/blog/plantilla([1-3])/([^/]+)/$
RewriteCond %{DOCUMENT_ROOT}/blog/plantilla%1/%2/index.html !-f
RewriteRule ^blog/plantilla([1-3])/([^/]+)/$ /blog/plantilla$1/nuevo/index.html [L]

# 6. Servir index.html
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*)/$ $1/index.html [L]